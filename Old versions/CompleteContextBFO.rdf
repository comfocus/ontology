            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000118>questionnaire capturing and reporting agent</obo:IAO_0000118>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T13:49:44Z</dc:date>
        <dc:description>A role realized by a person in a research process.</dc:description>
        <rdfs:label xml:lang="en">researcher role</rdfs:label>
    </owl:Class>
    


