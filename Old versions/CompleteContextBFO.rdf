        <rdfs:label xml:lang="en">pantry</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000009 -->

