        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <obo:IAO_0000115>The event hierarchy includes concepts that represent occurrences (excluding procedures and interventions).</obo:IAO_0000115>
        <rdfs:label>event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_Contextv4#digital_location -->

