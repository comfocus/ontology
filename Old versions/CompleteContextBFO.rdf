        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T14:19:00Z</dc:date>
        <dc:description>Socio-economic status (SES) is a measure of an individual&apos;s economic and social position.</dc:description>
        <rdfs:label xml:lang="en">socio-economic status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000020 -->

