https://dictionary.cambridge.org/dictionary/english/month</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#season -->

    <owl:Class rdf:about="http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#season">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000038"/>
        <rdfs:comment>one of the four periods of the year; spring, summer, autumn, or winter 

https://dictionary.cambridge.org/dictionary/english/season</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#social_context -->

