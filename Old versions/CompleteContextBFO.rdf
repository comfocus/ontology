        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T13:59:34Z</dc:date>
        <dc:description>An assortment is a collection of different food entities.</dc:description>
        <rdfs:label xml:lang="en">food assortiment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000010 -->

