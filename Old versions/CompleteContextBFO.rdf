        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:comment>Physical location is a site such as restaurant or supermarket (as listed options in the instances) where an experiment or study can take place</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_Contextv4#site_status -->

