                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-25T09:24:37Z</dc:date>
        <rdfs:comment>A question that allows respondents to choose one of two answer choices.</rdfs:comment>
        <rdfs:label xml:lang="en">dichotomous</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000533 -->

    <owl:Class rdf:about="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000533">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000470"/>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-25T09:27:02Z</dc:date>
        <rdfs:label xml:lang="en">semantic differential</rdfs:label>
        <foaf:homepage>Semantic differential questions are considered to be rating scale questions. The question type does not label each rating point with an individual descriptive like Likert-scale questions. 

In Semantic differential questions, two statements are placed one at the far left and the opposite statement is placed at the far right. In this question type, a numbering system is used within the scale and the respondents will choose a number between the two statements.</foaf:homepage>
    </owl:Class>
    


