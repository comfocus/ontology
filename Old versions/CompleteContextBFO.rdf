        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T14:16:48Z</dc:date>
        <dc:description>The quality of belonging to a household.</dc:description>
        <rdfs:label xml:lang="en">household composition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000019 -->

