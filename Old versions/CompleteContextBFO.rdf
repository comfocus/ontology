    <owl:Ontology rdf:about="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_Contextv4">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/1.0.0"/>
        <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2019-08-26/bfo.owl"/>
        <dc:description>The Food Consumer Science Ontology (COMFOCUS) is an ontology od entities related to an individual giving an expression about a target in ambient and target context.</dc:description>
        <dc:title>Context for Food Consumer Science Ontology (COMFOCUS)</dc:title>
        <terms:licence>http://creativecommons.org/licences/by/4.0</terms:licence>
        <rdfs:comment>This version of ontology context was built based to the fisrt version of the COMFOCUS ontology by Barbara Koroušić Seljak</rdfs:comment>
        <rdfs:isDefinedBy>Henssen Ruben
van Leewen Nina
Nedelkou Anastasia
Royer Clarisse</rdfs:isDefinedBy>
        <owl:versionInfo>2023-06-30</owl:versionInfo>
    </owl:Ontology>
    


