        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000038"/>
        <rdfs:comment>numerical representation of a specific calendar day within a given month</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#day_of_week -->

