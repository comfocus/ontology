        <rdfs:comment>Digital location is a site such as smartphone application or online supermarket (as listed options in the instances) where an experiment or study can take place</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_Contextv4#holiday -->

    <owl:Class rdf:about="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_Contextv4#holiday">
