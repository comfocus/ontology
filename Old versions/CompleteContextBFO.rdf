        <dc:description>A consumption pattern is a collection of food entities characterized by types and quantities, and their combination in dishes and meals.</dc:description>
        <rdfs:label xml:lang="en">consumption pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000011 -->

