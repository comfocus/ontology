        <dc:description>A household is a collection of person entities that occupy a housing unit.</dc:description>
        <rdfs:label xml:lang="en">household</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000004 -->

    <owl:Class rdf:about="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000118>individual role</obo:IAO_0000118>
        <obo:IAO_0000118>questionnaire respondent role</obo:IAO_0000118>
        <obo:IAO_0000118>rater role</obo:IAO_0000118>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T13:43:07Z</dc:date>
        <dc:description>A role realized by a person in a process such that the person causes the process, i.e., gives expression (attribute) about something (objects) in a particularly micro-context. Food consumers or raters can be many and highly diverse (say from a 25-year-old Portuguese female extrovert to a 50-year-old introvert male from Hungary).</dc:description>
        <rdfs:label xml:lang="en">food consumer role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000005 -->

