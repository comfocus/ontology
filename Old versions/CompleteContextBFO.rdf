    <!-- http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#target_presentation_format -->

    <owl:Class rdf:about="http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#target_presentation_format">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000615"/>
        <rdfs:comment>the format in which the target is presented in experiment</rdfs:comment>
        <rdfs:label>TargetPresentationFormat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#task_demand -->

    <owl:Class rdf:about="http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#task_demand">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment>cognitive context on the individual created by a specific task demand during the experiment by emposing mental workload or/and time pressure

mental workload: 
reflects the amount of mental resources required to perform a set of concurrent tasks 
https://www.sciencedirect.com/topics/engineering/mental-workload

time pressure:
a type of psychological stress that occurs when a person has less time available (real or perceived) than is necessary to complete a task or obtain a result
https://www.atdata.com/blog/what-is-time-pressure#:~:text=Time%20pressure%20is%20a%20type,research%20and%20compare%20less%20criteria.</rdfs:comment>
        <rdfs:comment>continuant, dependent ?</rdfs:comment>
        <rdfs:comment>relate this to planned process or experiment execution</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#time_zone -->

    <owl:Class rdf:about="http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#time_zone">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/clarisse/ontologies/2023/5/CompleteOntoContextV11#spatial_region_quality"/>
        <rdfs:comment>continuant, dependent, quality</rdfs:comment>
        <rdfs:comment>link this to temporality</rdfs:comment>
        <rdfs:comment>one of many equal parts into which the world is divided. In any place within each part, the particular point in the day is the same, and is an hour in front of or behind that in the parts on either side

https://dictionary.cambridge.org/dictionary/english/time-zone</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#year -->

    <owl:Class rdf:about="http://www.semanticweb.org/clarisse/ontologies/2023/5/OntoV24#year">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000038"/>
        <rdfs:comment>a period of twelve months, especially from 1 January to 31 December

https://dictionary.cambridge.org/dictionary/english/year</rdfs:comment>
    </owl:Class>
    


