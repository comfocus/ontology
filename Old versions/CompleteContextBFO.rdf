        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-25T09:24:21Z</dc:date>
        <dc:description>Balanced Scale questions are considered to be rating scale questions. In Balanced Scale questions, the number of positive and negative statements for each rating points are equal. In addition, to positive and negative statements for a Balanced Scale question, a neutral midpoint is also needed to balance the scales in this type of question.</dc:description>
        <rdfs:label xml:lang="en">balanced scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000532 -->

