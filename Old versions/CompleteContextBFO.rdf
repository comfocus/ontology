    <!-- http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000359 -->

    <owl:Class rdf:about="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000359">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000388"/>
        <obo:IAO_0000112>The most common answer choices are on agreement (e.g., Strongly
Agree to Strongly Disagree), frequency (e.g., Very Frequently to Never), importance (e.g., Very Important to Never), quality (e.g., Very Good to Very Poor), and likelihood (e.g., Almost Always True to Almost Never True).</obo:IAO_0000112>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-19T07:35:38Z</dc:date>
        <rdfs:comment>Likert Scale questions are most widely used to measure someone&apos;s attitude and behaviour by answer choices that range from one extreme to another. 

Likert Scale questions are given scores or assigned weight to each answer choices for each question.</rdfs:comment>
        <rdfs:label xml:lang="en">Likert scale</rdfs:label>
    </owl:Class>
    


