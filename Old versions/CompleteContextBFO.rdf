    <!-- http://purl.obolibrary.org/obo/OBI_0500000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0500000">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/bkorousicseljak/ontologies/2023/5/Comfocus_v1/COMFOCUS_00000000000000000423"/>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-19T07:17:57Z</dc:date>
        <dc:description>A plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution.</dc:description>
        <rdfs:label xml:lang="en">study design</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ONS_0000085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ONS_0000085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <dc:creator rdf:resource="http://orcid.org/0000-0001-7597-2590"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T13:54:25Z</dc:date>
        <dc:description>A meal is a collection of food entities consumed at a specific occasion, such as breakfast, lunch, dinner or snack. 

A meal is an eating/drinking occasion which usually accours at certain time during the day. During a meal, through processes of eating and drinking, food is consumed.</dc:description>
        <rdfs:label xml:lang="en">meal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ogms.owl#SCTO_223496003 -->

